<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Idea 评审报告</title>
<style>
{% include "_style.css" %}
</style>
<script>
{% include "_theme.js" %}
</script>
</head>
<body>

{% macro level(v) -%}<span class="badge b-{{ v }}">{{ LEVEL[v] }}</span>{%- endmacro %}
{% macro pubbadge(p) -%}
{%- if p.local_path -%}<span class="badge b-unk">本地</span>
{%- elif p.peer_reviewed is true -%}<span class="badge b-pub">已发表</span>
{%- elif p.peer_reviewed is false -%}<span class="badge b-pre">预印本</span>
{%- else -%}<span class="badge b-unk">发表情况不明</span>{%- endif -%}
{%- endmacro %}
{% macro plist(items) -%}
{%- if items %}<ul class="tight">{% for i in items %}<li>{{ i | refs }}</li>{% endfor %}</ul>{% else %}<span class="meta">无</span>{% endif -%}
{%- endmacro %}

<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Idea 评审报告 · {{ meta.created | replace("T", " ") }}</div>
    <h1>{{ plan.restated_idea if plan else idea }}</h1>
    <p class="idea">你的原始 idea：{{ idea }}</p>
    <div class="stats">
      <div class="stat"><b class="num">{{ stats.candidates }}</b><span>篇候选文献{% if stats.local %}，另有本地 {{ stats.local }} 篇{% endif %}</span></div>
      <div class="stat"><b class="num">{{ stats.read }}</b><span>篇读了全文</span></div>
      <div class="stat"><b class="num">{{ stats.high }} / {{ stats.low }}</b><span>篇高质量 / 低质量</span></div>
      <div class="stat"><b class="num">{{ stats.mismatch }}</b><span>篇摘要夸大或和正文矛盾</span></div>
      <div class="stat"><b class="num">{{ stats.gaps }}</b><span>个文献空白</span></div>
      <div class="stat"><b class="num">{{ stats.proposals }} × {{ stats.reviewers }}</b><span>份 proposal × 评审模型</span></div>
    </div>
    {% if warnings %}
    <div class="warn"><b>注意</b><ul class="tight">{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
    {% endif %}
    {% if shortfall %}{% set why %}{% if shortfall.reason == "few" %}只读到 {{ shortfall.read }} 篇全文，少于 {{ shortfall.need }} 篇{% else %}读到的 {{ shortfall.read }} 篇全文都是低质量{% endif %}{% endset %}
    {% if stopped %}
    <div class="warn"><b>文献证据不够，停在了第 5 步</b>
      <p style="margin:6px 0">{{ why }}。拿这么少或这么弱的文献去找空白、写 proposal，结果多半站不住，所以后面几步没有跑。可以这样补：</p>
      <ul class="tight">
        <li>把下面"很相关，但没读到全文"里的论文下载下来，按编号放进 <code>{{ run_dir }}/papers/</code>，再运行 <code>idea-review run --resume {{ run_dir }}</code>。</li>
        <li>检索结果本身太少的话，换几条检索式（<code>--query</code>）或者调大 <code>search.per_query</code>，开一次新的运行。</li>
        <li>确实想用现有的文献跑完，接着跑时加 <code>--force</code>。</li>
      </ul></div>
    {% else %}
    <div class="warn"><b>文献证据偏弱</b>：{{ why }}。下面的空白和 proposal 只能当线索，先多补几篇文献再下判断。</div>
    {% endif %}{% endif %}
  </div>
</header>

<nav class="toc"><div class="wrap">
  <div class="links"><a href="#search">① 检索</a><a href="#papers">② 文献</a><a href="#gaps">③ 空白</a>
  <a href="#proposals">④ 方案和评审</a><a href="#decide">⑤ 你拍板</a><a href="#appendix">附录</a></div>
  <button type="button" id="theme-toggle" class="theme" data-to-dark="切到深色" data-to-light="切到浅色" hidden></button>
</div></nav>

<main class="wrap">

<section id="search">
  <h2>① 检索</h2>
  {% if plan %}
  <div class="card">
    <div class="kv"><b>领域</b>{{ plan.field }}</div>
    <div class="kv"><b>核心概念</b></div>
    <div class="chips">{% for c in plan.core_concepts %}<span class="chip">{{ c }}</span>{% endfor %}</div>
    <div class="kv"><b>检索式</b></div>
    <ul class="tight">{% for q in plan.search_queries %}<li><code>{{ q }}</code></li>{% endfor %}</ul>
    <div class="meta">检索源：{{ cfg.search.sources | join("、") }}。先按标题和摘要初筛，再按相关度从高到低下载全文来精读，下载失败的往下顺延；候选里能下载的用完了还不够数，会从检索结果里再多取一些候选。</div>
    <h4>参考文献数量</h4>
    <table>
      <tr><th></th><th>设定</th><th>实际</th></tr>
      <tr><td>每条检索式、每个来源</td><td>取 {{ counts.per_query }} 篇</td><td class="meta">—</td></tr>
      <tr><td>候选文献（进初筛）</td><td>最多 {{ counts.max_candidates }} 篇</td>
        <td>{{ stats.candidates }} 篇{% if count_notes.candidates %} <span class="meta">{{ count_notes.candidates | join("；") }}</span>{% endif %}</td></tr>
      <tr><td>精读全文</td><td>{{ counts.download }} 篇</td>
        <td>{{ stats.fulltext }} 篇{% if count_notes.fulltext %} <span class="meta">{{ count_notes.fulltext | join("；") }}</span>{% endif %}</td></tr>
      {%- if stats.local %}
      <tr><td>你提供的本地 PDF</td><td class="meta">—</td><td>{{ stats.local }} 篇 <span class="meta">另算，不占精读名额</span></td></tr>
      {%- endif %}
    </table>
    <div class="meta">运行时可以用 <code>--candidates N</code> 改候选篇数，<code>--refs N</code> 改精读篇数。</div>
  </div>
  {% else %}<p class="meta">这一步还没完成。</p>{% endif %}
</section>

<section id="papers">
  <h2>② 文献</h2>
  <p class="lead">"质量"是模型读完全文后的判断，只看论文本身的证据；"已发表 / 预印本"来自检索元数据。质量按论文类型分别判断：综述看覆盖和归纳，立场文章看论证，数据集和工具看构建和质量控制，不会因为没做实验就判低。摘要夸大或和正文矛盾的论文，结论以正文为准；摘要没交代适用范围的，也在笔记里单独列出。</p>
  {% if read %}
  <div class="table-wrap"><table>
    <thead><tr><th>编号</th><th>论文</th><th>年份</th><th>出处</th><th class="num">被引</th><th>质量</th><th>摘要和正文</th></tr></thead>
    <tbody>
    {% for x in read %}{% set p = x.paper %}{% set r = x.review %}
      <tr>
        <td><a class="ref" href="#paper-{{ p.paper_id }}">{{ p.paper_id }}</a></td>
        <td>{{ p.title }}</td>
        <td class="num">{{ p.year or "—" }}</td>
        <td>{{ pubbadge(p) }} <span class="meta">{{ p.venue or "" }}</span></td>
        <td class="num">{{ p.citation_count if p.citation_count is not none else "—" }}</td>
        <td>{{ level(r.quality.tier) }}{% if r.quality.paper_type != "other" %} <span class="meta">{{ PAPER_TYPE[r.quality.paper_type] }}</span>{% endif %}</td>
        <td>{% if not r.abstract_vs_body.consistent %}<span class="badge b-warn">夸大或矛盾</span>
          {%- elif r.abstract_vs_body.scope_gaps %}<span class="meta">没交代适用范围</span>
          {%- else %}<span class="meta">一致</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>

  <h3>逐篇精读笔记</h3>
  {% for x in read %}{% set p = x.paper %}{% set r = x.review %}
  <details class="paper" id="paper-{{ p.paper_id }}">
    <summary>
      <span class="ref">{{ p.paper_id }}</span> <span class="title">{{ p.title }}</span><br>
      <span class="meta">{{ p.year or "年份不明" }} · {{ p.venue or "出处不明" }} · </span>{{ pubbadge(p) }}
      质量 {{ level(r.quality.tier) }}{% if r.quality.paper_type != "other" %} <span class="meta">· {{ PAPER_TYPE[r.quality.paper_type] }}</span>{% endif %}
      {% if not r.abstract_vs_body.consistent %}<span class="badge b-warn">摘要夸大或和正文矛盾</span>{% endif %}
      {% if x.truncated %}<span class="badge b-unk">全文过长，中间有省略</span>{% endif %}
    </summary>
    <div class="body">
      <p class="meta">
        {% if p.authors %}{{ p.authors[:6] | join("、") }}{% if p.authors | length > 6 %} 等{% endif %} · {% endif %}
        {% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">原文链接</a> · {% endif %}
        {% if x.pdf %}本地 PDF：<code>{{ x.pdf }}</code>{% endif %}
      </p>
      <div class="kv"><b>实际做了什么</b>{{ r.what_it_actually_does | refs }}</div>
      {% if r.abstract_vs_body.overclaims %}
      <div class="mismatch"><b>摘要夸大或和正文矛盾：</b>{{ plist(r.abstract_vs_body.overclaims) }}</div>
      {% endif %}
      {% if r.abstract_vs_body.scope_gaps %}
      <div class="kv"><b>摘要没交代的适用范围</b>{{ plist(r.abstract_vs_body.scope_gaps) }}</div>
      {% endif %}
      <div class="grid2">
        <div>
          <div class="kv"><b>问题</b>{{ r.problem | refs }}</div>
          <div class="kv"><b>方法</b>{{ r.method | refs }}</div>
          <div class="kv"><b>实验设置</b>{{ r.setup | refs }}</div>
          <h4>主要结果</h4>{{ plist(r.key_results) }}
        </div>
        <div>
          <h4>质量判断：{{ level(r.quality.tier) }}{% if r.quality.paper_type != "other" %}（{{ PAPER_TYPE[r.quality.paper_type] }}）{% endif %}</h4>
          <div class="meta">{{ r.quality.tier_reason | refs }}</div>
          <div class="kv"><b>证据强度</b>{{ level(r.quality.evidence_strength) }}　<b>可复现</b>{{ level(r.quality.reproducibility) }}</div>
          <h4>严谨性</h4>{{ plist(r.quality.rigor) }}
          {% if r.quality.red_flags %}<h4>危险信号</h4>{{ plist(r.quality.red_flags) }}{% endif %}
        </div>
      </div>
      <div class="callout"><b>和你的 idea 的关系：</b>{{ r.relevance_to_idea | refs }}</div>
      <div class="grid2">
        <div><h4>局限</h4>{{ plist(r.limitations) }}</div>
        <div><h4>还没解决的问题</h4>{{ plist(r.open_questions) }}</div>
      </div>
    </div>
  </details>
  {% endfor %}
  {% else %}<p class="meta">还没有读到全文的论文。</p>{% endif %}

  {% if missing or failed_reads %}
  <h3>很相关，但没读到全文</h3>
  <p class="lead">把 PDF 下载下来，按编号命名放进 <code>{{ run_dir }}/papers/</code>（比如 <code>P07.pdf</code>），再运行 <code>idea-review run --resume {{ run_dir }}</code>。程序会抽出全文、补精读，再按新的文献重做找空白到综合元评审这几步；已经读过的论文不重读。精读失败的，直接再运行这条命令就会重读。</p>
  <div class="table-wrap"><table>
    <thead><tr><th>编号</th><th>论文</th><th>原因</th></tr></thead>
    <tbody>
    {% for x in missing %}<tr id="paper-{{ x.paper.paper_id }}"><td><span class="ref">{{ x.paper.paper_id }}</span></td>
      <td>{% if x.paper.url %}<a href="{{ x.paper.url }}" target="_blank" rel="noopener">{{ x.paper.title }}</a>{% else %}{{ x.paper.title }}{% endif %}<br><span class="meta">{{ x.paper.year or "" }} {{ x.paper.venue or "" }}</span></td>
      <td class="meta">{{ x.fulltext.note }}</td></tr>{% endfor %}
    {% for x in failed_reads %}<tr id="paper-{{ x.paper.paper_id }}"><td><span class="ref">{{ x.paper.paper_id }}</span></td>
      <td>{{ x.paper.title }}</td><td class="error">精读失败：{{ x.error }}</td></tr>{% endfor %}
    </tbody>
  </table></div>
  {% endif %}

  {% if others %}
  <details class="paper" style="margin-top:16px">
    <summary><span class="title">其余 {{ others | length }} 篇候选（只看了标题和摘要）</span></summary>
    <div class="body"><div class="table-wrap" style="border:0"><table>
      <thead><tr><th>编号</th><th>论文</th><th>年份</th><th>初筛</th><th>理由</th></tr></thead>
      <tbody>
      {% for x in others %}<tr id="paper-{{ x.paper.paper_id }}">
        <td><span class="ref">{{ x.paper.paper_id }}</span></td>
        <td>{% if x.paper.url %}<a href="{{ x.paper.url }}" target="_blank" rel="noopener">{{ x.paper.title }}</a>{% else %}{{ x.paper.title }}{% endif %}</td>
        <td class="num">{{ x.paper.year or "—" }}</td>
        <td>{% if x.screen %}{{ level(x.screen.relevance) }}{% endif %}</td>
        <td class="meta">{{ x.screen.reason if x.screen else "" }}</td>
      </tr>{% endfor %}
      </tbody>
    </table></div></div>
  </details>
  {% endif %}
</section>

<section id="gaps">
  <h2>③ 版图和空白</h2>
  {% if landscape %}
  <div class="card"><div class="kv"><b>现状</b>{{ landscape.summary | refs }}</div></div>
  {% if landscape.clusters %}
  <h3>几类做法</h3>
  <div class="grid2">
    {% for c in landscape.clusters %}<div class="card"><b>{{ c.name }}</b>
      <div class="chips">{% for pid in c.paper_ids %}{{ pid | refs }}{% endfor %}</div>
      <div>{{ c.summary | refs }}</div></div>{% endfor %}
  </div>
  {% endif %}
  <h3>空白</h3>
  <p class="meta">有没有人做过，这里不替你判断：只列出读过的论文里离它最近的几篇，和给你自己去查的检索式。</p>
  {% for g in landscape.gaps %}
  <div class="card gap-card" id="gap-G{{ loop.index }}">
    <div class="meta">G{{ loop.index }} · {{ KIND.get(g.kind, g.kind) }} · {% if g.source == "authors_admit" %}论文作者自己承认{% else %}模型推断{% endif %}
      {%- if loop.index in weak_gaps %} <span class="badge b-warn">没有高、中质量的论文支撑</span>{% endif %}</div>
    <h3 style="margin-top:4px">{{ g.title }}</h3>
    <div>{{ g.description | refs }}</div>
    <h4>证据</h4>
    <ul class="tight">{% for e in g.evidence %}<li>{{ e.paper_id | refs }}：{{ e.note | refs }}</li>{% endfor %}</ul>
    <div class="kv"><b>为什么重要</b>{{ g.why_it_matters | refs }}</div>
    {% if g.closest_read %}<h4>读过的论文里最近的</h4>
    <ul class="tight">{% for c in g.closest_read %}<li>{{ c.paper_id | refs }}：{{ c.how_close | refs }}</li>{% endfor %}</ul>{% endif %}
    {% if g.check_queries %}<div class="kv"><b>自己补查</b>{% for q in g.check_queries %}<code class="q">{{ q }}</code>{% if not loop.last %} {% endif %}{% endfor %}</div>{% endif %}
    {% if g.already_done_risk %}<div class="kv"><b>撞车风险</b>{{ g.already_done_risk | refs }}</div>{% endif %}
  </div>
  {% endfor %}
  {% else %}<p class="meta">{% if stopped %}文献证据不够，这一步没有跑，见页面顶部的说明。{% else %}这一步还没完成。{% endif %}</p>{% endif %}
</section>

<section id="proposals">
  <h2>④ 方案和评审</h2>
  <p class="lead">proposal 由 <b>{{ cfg.provider("writer").describe() }}</b> 写；元评审由
    {% for p in cfg.reviewer_providers() %}<b>{{ p.describe() }}</b>{% if not loop.last %}、{% endif %}{% endfor %}
    在新对话里各自独立完成，评审只拿到 proposal 和论文材料，看不到写作过程。</p>

  {% for v in proposals %}{% set rec = v.rec %}{% set prop = rec.proposal %}
  <div class="card proposal" id="proposal-{{ rec.proposal_id }}">
    <div class="tag">{{ rec.proposal_id }} · {% if rec.origin == "original" %}你的原始 idea{% else %}从文献空白里挖出的新方向{% endif %}</div>
    {% if prop %}
    <h3 style="margin-top:4px;font-size:19px">{{ prop.title }}</h3>
    <p><b>{{ prop.one_liner }}</b></p>
    {% if rec.seed %}<div class="callout">和原始 idea 的区别：{{ rec.seed.differs_from_original | refs }}<br>依据的空白：{% for g in rec.seed.based_on_gaps %}{{ g | refs }} {% endfor %}</div>{% endif %}
    <div class="grid2">
      <div>
        <div class="kv"><b>问题</b>{{ prop.problem | refs }}</div>
        <div class="kv"><b>现有方法为什么不行</b>{{ prop.why_existing_fail | refs }}</div>
        <div class="kv"><b>方法</b>{{ prop.method | refs }}</div>
      </div>
      <div>
        <h4>最接近的工作</h4>
        <ul class="tight">{% for c in prop.closest_work %}<li>{{ c.paper_id | refs }}：重合 {{ c.overlap | refs }}；区别 {{ c.difference | refs }}</li>{% else %}<li class="meta">无</li>{% endfor %}</ul>
      </div>
    </div>
    <h4>最小实验（{{ prop.minimal_experiment.duration }}）</h4>
    <div>{{ prop.minimal_experiment.setup | refs }}</div>
    <div class="meta">数据：{{ prop.minimal_experiment.data }}；基线：{{ prop.minimal_experiment.baselines | join("、") }}；指标：{{ prop.minimal_experiment.metrics | join("、") }}</div>
    <div class="kv kill"><b>不成立的信号</b>{{ prop.falsification | refs }}</div>
    <div class="grid2">
      <div><h4>风险</h4>{{ plist(prop.risks) }}</div>
      <div><h4>需要补查</h4>{{ plist(prop.needs_checking) }}</div>
    </div>
    {% if prop.questions_for_author %}<h4>需要你自己回答</h4>{{ plist(prop.questions_for_author) }}{% endif %}

    <h3>元评审</h3>
    {% if v.chair %}{% set c = v.chair %}{% set s = c.s %}
    {% set verdicts = {"confirmed": ("材料证实撞车", "b-warn"), "partial": ("部分重合", "b-medium"), "not_supported": ("材料不支持这个说法", "b-high"), "unverifiable": ("核对不了", "b-unk")} %}
    <div class="chair">
      <b>综合元评审</b> <span class="meta">由 {{ c.chair }}{% if c.detail %}（{{ c.detail }}）{% endif %} 综合 {{ c.n }} 位评审的意见（{{ c.legend }}），不下结论</span>
      {%- if c.family and c.family == cfg.provider("writer").family %} <span class="badge b-warn">和写 proposal 的是同一家模型</span>{% endif %}
      <p>{{ s.summary | refs }}</p>
      {% if s.key_issues %}<h4>要紧的问题</h4>
      <ol class="tight">{% for i in s.key_issues %}<li>{{ i.issue | refs }}{% if i.everyone %} <span class="badge b-warn">{{ c.n }} 家都提到</span>{% endif %}
        <span class="meta">（{{ i.raised_by | join("、") }}；{{ "论文" if i.source == "paper" else "推断" }}：{{ i.basis | refs }}）</span></li>{% endfor %}</ol>{% endif %}
      {% if s.overlap_check %}<h4>撞车论文核对</h4>
      <ul class="tight">{% for o in s.overlap_check %}{% set vd = verdicts.get(o.verdict, (o.verdict, "b-unk")) %}<li>{% if o.paper_id != "external" %}{{ o.paper_id | refs }} {% endif %}{{ o.title }} <span class="badge {{ vd[1] }}">{{ vd[0] }}</span> <span class="meta">（{{ o.raised_by | join("、") }}）</span><br>
        评审说：{{ o.claim | refs }}<br><span class="meta">核对：{{ o.evidence | refs }}</span></li>{% endfor %}</ul>{% endif %}
      {% if s.disagreements %}<h4>有分歧的地方</h4>
      <ul class="tight">{% for d in s.disagreements %}<li><b>{{ d.topic }}</b>：{{ d.positions | join("；") | refs }}<br><span class="meta">怎么判断谁对：{{ d.how_to_settle | refs }}</span></li>{% endfor %}</ul>{% endif %}
      {% set f = s.first_experiment %}
      <h4>最该先做的实验</h4>
      <p style="margin:4px 0">{{ f.experiment | refs }}<br><span class="meta">对比：{{ f.compare_against }}；指标：{{ f.metric }}；用时：{{ f.est_days }}；取自：{{ f.drawn_from | join("、") }}</span><br>
        <span class="kill">放弃：{{ f.kill_if | refs }}</span><br><span class="go">继续：{{ f.continue_if | refs }}</span></p>
      {% if s.questions_for_author %}<h4>投入之前要回答的问题</h4>{{ plist(s.questions_for_author) }}{% endif %}
      {% if s.must_verify %}<h4>你必须亲自核实</h4>{{ plist(s.must_verify) }}{% endif %}
    </div>
    {% endif %}
    {% set tl = v.tally %}{% if tl.n %}
    <div class="callout">
      <b>评审列出的撞车论文</b> <span class="meta">（程序按 {{ tl.n }} 家评审的意见统计）</span>
      {% if tl.rows %}<ul class="tight">{% for row in tl.rows %}<li>{% if row.paper_id %}{{ row.paper_id | refs }} {% endif %}{{ row.title }}：{{ tl.n }} 家里 {{ row.by | length }} 家（{{ row.by | join("、") }}）
        {%- if not row.paper_id %} <span class="badge b-unk">附上的论文以外，需核实</span>{% endif %}
        {%- if tl.n > 1 and row.by | length == 1 %} <span class="badge b-warn">只有一家这么说，不稳</span>{% endif %}</li>{% endfor %}</ul>
      <p class="meta">几家都列出的，也要自己点开正文核实：评审看的是同一批材料，可能一起看错。{% if tl.n == 1 %}这次只有一家评审，没法互相对照。{% endif %}</p>
      {% else %}<p class="meta">评审都没在附上的论文里找到撞车的。这不等于没人做过。</p>{% endif %}
    </div>
    {% endif %}
    <div class="reviewers">
      {% for m in v.metas %}
      <div class="reviewer">
        <h4>{{ m.reviewer }} <span class="meta">{{ m.model }}</span></h4>
        {% if m.review %}{% set r = m.review %}
        <b>撞车</b>
        {% if r.overlap %}<ul class="tight">{% for o in r.overlap %}<li>{{ o.paper_id | refs }} {{ o.title }}{% if not o.read_full_text %} <span class="badge b-unk">没读全文，需核实</span>{% endif %}<br>
          <span class="meta">实际做了：{{ o.what_it_actually_does | refs }}</span><br>重合：{{ o.overlap | refs }}；区别：{{ o.difference | refs }}</li>{% endfor %}</ul>
        {% else %}<p class="meta">{{ r.no_overlap_note }}</p>{% endif %}
        {% if r.abstract_body_mismatches %}<b>摘要夸大或和正文矛盾</b>{{ plist(r.abstract_body_mismatches) }}{% endif %}
        <b>最可能的死因</b>
        <ol class="tight">{% for d in r.causes_of_death %}<li>{{ d.reason | refs }} <span class="meta">（{{ "论文" if d.source == "paper" else "推断" }}：{{ d.basis | refs }}）</span></li>{% endfor %}</ol>
        <b>可行性</b>
        <p style="margin:4px 0">卡点：{{ r.feasibility.bottleneck | refs }}<br>绕法：{{ r.feasibility.workaround | refs }}</p>
        {% set f = r.cheapest_falsification %}
        <b>最便宜的证伪实验</b>（{{ f.est_days }}）
        <p style="margin:4px 0">{{ f.experiment | refs }}<br><span class="meta">对比：{{ f.compare_against }}；指标：{{ f.metric }}</span><br>
          <span class="kill">放弃：{{ f.kill_if | refs }}</span><br><span class="go">继续：{{ f.continue_if | refs }}</span></p>
        <b>投入之前必须回答</b>{{ plist(r.questions_for_author) }}
        {% else %}<p class="error">评审失败：{{ m.error }}</p>{% endif %}
      </div>
      {% else %}<p class="meta">还没有评审结果。</p>{% endfor %}
    </div>
    {% else %}<p class="error">这份 proposal 没写出来：{{ rec.error }}</p>{% endif %}
  </div>
  {% else %}<p class="meta">{% if stopped %}文献证据不够，这一步没有跑，见页面顶部的说明。{% else %}这一步还没完成。{% endif %}</p>{% endfor %}
</section>

<section id="decide">
  <h2>⑤ 你拍板</h2>
  <p class="lead">报告只帮你把材料摆齐。下面四个问题答得上来，再决定要不要投入几个月。</p>
  <div class="card"><ul class="checklist">
    <li><label><input type="checkbox">评审说撞车的那几篇，我自己点开读过正文了吗？还撞吗？</label></li>
    <li><label><input type="checkbox">几家都提到的死因是什么？我有办法解决吗？</label></li>
    <li><label><input type="checkbox">证伪实验开始之前，"出现什么结果就放弃"我写下来了吗？</label></li>
    <li><label><input type="checkbox">三天内跑完了吗？结果是什么？</label></li>
  </ul>
  <p class="meta">跑实验的时候自己盯着看：下一个好问题，往往就藏在那些看不懂的现象里。</p></div>
</section>

<section id="appendix">
  <h2>附录</h2>
  <h3>各环节用的模型</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>环节</th><th>模型</th></tr></thead>
    <tbody>
      <tr><td>拆检索词</td><td>{{ cfg.provider("planner").describe() }}</td></tr>
      <tr><td>按摘要初筛</td><td>{{ cfg.provider("screener").describe() }}</td></tr>
      <tr><td>精读全文、评质量</td><td>{{ cfg.provider("reader").describe() }}</td></tr>
      <tr><td>找空白</td><td>{{ cfg.provider("miner").describe() }}</td></tr>
      <tr><td>挖新方向、写 proposal（模型 A）</td><td>{{ cfg.provider("writer").describe() }}</td></tr>
      <tr><td>元评审（模型 B、C、D…）</td><td>{% for p in cfg.reviewer_providers() %}{{ p.describe() }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
      <tr><td>综合元评审</td><td>{{ cfg.provider("chair").describe() }}</td></tr>
    </tbody>
  </table></div>
  {% if usage %}
  <h3>用量</h3>
  <div class="table-wrap"><table>
    <thead><tr><th>模型</th><th class="num">调用次数</th><th class="num">输入 token</th><th class="num">输出 token</th></tr></thead>
    <tbody>{% for name, u in usage.items() %}<tr><td>{{ name }} <span class="meta">{{ u.model }}</span></td><td class="num">{{ u.calls }}</td><td class="num">{{ "{:,}".format(u.input_tokens) }}</td><td class="num">{{ "{:,}".format(u.output_tokens) }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% endif %}
  <h3>提示词</h3>
  {% for name, text in prompt_texts %}
  <details class="paper"><summary><span class="title">{{ name }}</span></summary><div class="body"><pre>{{ text }}</pre></div></details>
  {% endfor %}
  <p class="meta">运行目录：<code>{{ run_dir }}</code>。每一步的原始结果都是 JSON，放在这个目录里。</p>
</section>

</main>
<footer><div class="wrap">
  这份报告只是帮你发现盲点。AI 给出的任何论文和判断，都要自己点开核实；拍板的是你。
</div></footer>
</body>
</html>
