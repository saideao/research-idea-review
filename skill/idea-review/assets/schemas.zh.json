{
 "QueryPlan": {
  "properties": {
   "restated_idea": {
    "description": "用一两句话复述这个 idea，说清要解决什么问题",
    "title": "Restated Idea",
    "type": "string"
   },
   "field": {
    "description": "所属的大领域，宽泛一点即可",
    "title": "Field",
    "type": "string"
   },
   "core_concepts": {
    "description": "3 到 6 个核心概念",
    "items": {
     "type": "string"
    },
    "title": "Core Concepts",
    "type": "array"
   },
   "search_queries": {
    "description": "4 到 8 条英文检索式，覆盖不同说法和相邻方向",
    "items": {
     "type": "string"
    },
    "title": "Search Queries",
    "type": "array"
   }
  },
  "required": [
   "restated_idea",
   "field",
   "core_concepts",
   "search_queries"
  ],
  "title": "QueryPlan",
  "type": "object",
  "additionalProperties": false
 },
 "ScreenItem": {
  "properties": {
   "paper_id": {
    "description": "论文编号，原样照抄，比如 P07",
    "title": "Paper Id",
    "type": "string"
   },
   "relevance": {
    "description": "值不值得下载全文来读：high / medium / low",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "title": "Relevance",
    "type": "string"
   },
   "reason": {
    "description": "一句话理由",
    "title": "Reason",
    "type": "string"
   }
  },
  "required": [
   "paper_id",
   "relevance",
   "reason"
  ],
  "title": "ScreenItem",
  "type": "object",
  "additionalProperties": false
 },
 "PaperReview": {
  "$defs": {
   "AbstractCheck": {
    "description": "摘要和正文对照。只有夸大或矛盾才算不一致；只是没交代适用范围的单独列，不打警示标记。",
    "properties": {
     "overclaims": {
      "description": "夸大或矛盾：摘要的说法正文不支持，或者数字、结论和正文对不上。每条写清摘要怎么说、正文实际是什么，注明页码如 [p.6]；没有就留空",
      "items": {
       "type": "string"
      },
      "title": "Overclaims",
      "type": "array"
     },
     "scope_gaps": {
      "description": "没交代适用范围：摘要的说法正文撑得住，但只在更窄的条件下成立（比如只测了部分模型、样本很小、只用了一个数据集），摘要没提。每条写清是什么条件，注明页码；没有就留空",
      "items": {
       "type": "string"
      },
      "title": "Scope Gaps",
      "type": "array"
     }
    },
    "required": [
     "overclaims",
     "scope_gaps"
    ],
    "title": "AbstractCheck",
    "type": "object",
    "additionalProperties": false
   },
   "QualityAssessment": {
    "properties": {
     "paper_type": {
      "description": "论文类型：empirical 方法或实证研究 / survey 综述 / position 立场或观点文章 / resource 数据集、基准或工具 / theory 理论分析 / other 其他",
      "enum": [
       "empirical",
       "survey",
       "position",
       "resource",
       "theory",
       "other"
      ],
      "title": "Paper Type",
      "type": "string"
     },
     "evidence_strength": {
      "description": "核心结论的证据强度",
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "title": "Evidence Strength",
      "type": "string"
     },
     "rigor": {
      "description": "对基线、消融、统计检验、数据规模等的具体观察，注明页码",
      "items": {
       "type": "string"
      },
      "title": "Rigor",
      "type": "array"
     },
     "reproducibility": {
      "description": "可复现程度：代码、数据、超参数是否给全",
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "title": "Reproducibility",
      "type": "string"
     },
     "red_flags": {
      "description": "危险信号，比如结论超出实验、没有基线、样本极小；没有就留空",
      "items": {
       "type": "string"
      },
      "title": "Red Flags",
      "type": "array"
     },
     "tier": {
      "description": "综合质量档位：high / medium / low",
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "title": "Tier",
      "type": "string"
     },
     "tier_reason": {
      "description": "定档理由，一两句话",
      "title": "Tier Reason",
      "type": "string"
     }
    },
    "required": [
     "paper_type",
     "evidence_strength",
     "rigor",
     "reproducibility",
     "red_flags",
     "tier",
     "tier_reason"
    ],
    "title": "QualityAssessment",
    "type": "object",
    "additionalProperties": false
   }
  },
  "properties": {
   "what_it_actually_does": {
    "description": "依据正文（不是摘要），这篇论文实际做了什么，三五句话",
    "title": "What It Actually Does",
    "type": "string"
   },
   "problem": {
    "description": "它要解决的问题",
    "title": "Problem",
    "type": "string"
   },
   "method": {
    "description": "方法要点",
    "title": "Method",
    "type": "string"
   },
   "setup": {
    "description": "实验设置：数据、基线、指标",
    "title": "Setup",
    "type": "string"
   },
   "key_results": {
    "description": "主要结果，注明页码",
    "items": {
     "type": "string"
    },
    "title": "Key Results",
    "type": "array"
   },
   "abstract_vs_body": {
    "$ref": "#/$defs/AbstractCheck"
   },
   "quality": {
    "$ref": "#/$defs/QualityAssessment"
   },
   "relevance_to_idea": {
    "description": "和用户的 idea 有什么关系：重合在哪、能借鉴什么",
    "title": "Relevance To Idea",
    "type": "string"
   },
   "limitations": {
    "description": "局限，区分作者自己承认的和你看出来的",
    "items": {
     "type": "string"
    },
    "title": "Limitations",
    "type": "array"
   },
   "open_questions": {
    "description": "文中提到或能直接看出、还没解决的问题，注明页码",
    "items": {
     "type": "string"
    },
    "title": "Open Questions",
    "type": "array"
   }
  },
  "required": [
   "what_it_actually_does",
   "problem",
   "method",
   "setup",
   "key_results",
   "abstract_vs_body",
   "quality",
   "relevance_to_idea",
   "limitations",
   "open_questions"
  ],
  "title": "PaperReview",
  "type": "object",
  "additionalProperties": false
 },
